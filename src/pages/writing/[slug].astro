---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Related from '../../components/Related.astro';
import { getPosts, getProjects, getResearch, neighbors, pick } from '../../lib/content';
import { formatMonth, readingTime, site } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so "older" is the next item in the list.
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, ...neighbors(posts, i) } }));
}

const { post, prev: newer, next: older } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const related = [
  ...pick(await getProjects(), d.projects).map((p) => ({ kind: 'Project', title: p.data.title, href: `/work/${p.id}` })),
  ...pick(await getResearch(), d.research).map((r) => ({ kind: 'Research', title: r.data.shortTitle, href: `/research/${r.id}` })),
];
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
---

<Base title={d.title} description={d.description} active="writing">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/writing">Writing</a> / <span aria-current="page">{d.title}</span></nav>

    <header class="post-head">
      {d.draft && <span class="badge">Draft · only visible locally</span>}
      {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
      <h1 class="h1">{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta">{site.name.toUpperCase()} · {formatMonth(d.date).toUpperCase()} · {readingTime(post.body)} MIN READ</p>
    </header>

    <div class="post-body">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="label subtle">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class="prose"><Content /></article>
    </div>

    {url && (
      <div class="share link-row">
        <span class="label subtle">Share</span>
        <a class="text-link" target="_blank" rel="noreferrer" href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`}><span>X ↗</span></a>
        <a class="text-link" target="_blank" rel="noreferrer" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}><span>LinkedIn ↗</span></a>
      </div>
    )}

    <Related items={related} />

    <nav class="pager" aria-label="More posts">
      {older ? <a href={`/writing/${older.id}`}><span>← Older</span><span>{older.data.title}</span></a> : <a href="/writing"><span>← Back to</span><span>All writing</span></a>}
      {newer && <a href={`/writing/${newer.id}`}><span>Newer →</span><span>{newer.data.title}</span></a>}
    </nav>
  </div>
</Base>

<style>
  .post-head { max-width: 860px; margin: 0 auto; padding-block: clamp(48px, 7vw, 88px) 48px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; }
  .post-head .tags { justify-content: center; }
  .post-head .lead { max-width: 680px; }
  .post-body { display: grid; grid-template-columns: 220px minmax(0, 720px); justify-content: center; gap: 64px; padding-top: 48px; border-top: 1px solid var(--line-soft); }
  .post-body:not(:has(.toc)) { grid-template-columns: minmax(0, 720px); }
  .toc { position: sticky; top: 112px; align-self: start; }
  .toc ol { list-style: none; margin: 14px 0 0; padding: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 8px 0 8px 16px; font-size: 14px; color: var(--muted); }
  .toc a:hover { color: var(--cyan); }
  .share { max-width: 720px; margin: 56px auto 0; padding-top: 24px; border-top: 1px solid var(--line); }
  @media (max-width: 960px) {
    .post-body { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .toc { position: static; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Contact from '../components/Contact.astro';
import SkillFinder from '../components/SkillFinder.astro';
import { site, hasResume, education, certifications, highlights } from '../site';
import { getProjects, getResearch, getExperience } from '../lib/content';

const featured = (await getProjects()).filter((p) => p.data.featured);
const research = await getResearch();
const roles = await getExperience();
const building = featured.find((p) => p.data.building);
---

<Base active="home">
  <section class="wrap hero" aria-labelledby="hero-title">
    <p class="label eyebrow"><span class="dot" aria-hidden="true"></span>{site.role}</p>
    <h1 id="hero-title" class="display hero-title">
      I build AI systems <span class="accent">that survive <span class="keep">contact with reality.</span></span>
    </h1>
    <div class="hero-copy">
      <p class="lead">Agents, retrieval, evaluation and infrastructure. I build them, test them, break them and ship them.</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Get in touch <span aria-hidden="true">→</span></a>
        <a href="#projects" class="btn btn-secondary">View projects</a>
        {hasResume && <a href={site.resume} class="btn btn-secondary" target="_blank" rel="noreferrer">Resume ↓</a>}
      </div>
      <nav class="link-row" aria-label="Social links">
        {site.socials.map((s) => <a class="text-link" href={s.href} target="_blank" rel="noreferrer"><span>{s.label} ↗</span></a>)}
        {site.email && <a class="text-link" href={`mailto:${site.email}`}><span>Email</span></a>}
      </nav>
      <p class="facts meta">{site.degree.toUpperCase()} · {site.location.toUpperCase()}</p>
      {building && (
        <a href={`/work/${building.id}`} class="now panel">
          <span class="badge"><span class="dot" aria-hidden="true"></span>Currently building</span>
          <span class="now-title">{building.data.title}</span>
          <span class="muted">{building.data.summary}</span>
          <span class="text-link"><span>View project →</span></span>
        </a>
      )}
    </div>
    <div class="hero-visual">
      <Portrait eager />
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">01 / About me</p>
          <h2 id="about-title" class="h2">About <span class="accent">me.</span></h2>
        </div>
      </div>
      <div class="card-grid-3">
        <article class="panel reveal stack-y">
          <h3 class="panel-title">Current</h3>
          <p class="muted">
            {building && <>Building <a class="inline" href={`/work/${building.id}`}>{building.data.title}</a>, self-maintaining APIs for teams and AI agents. </>}
            Recent M.S. graduate in Artificial Intelligence from <span class="hl">Rochester Institute of Technology</span>, based in the {site.location}.
          </p>
        </article>
        <article class="panel reveal stack-y">
          <h3 class="panel-title">Background</h3>
          <p class="muted">
            Bachelor’s in Computer Science from <span class="hl">R.M.K. Engineering College</span>, then ML engineering at
            Novacis Digital and research at RIT, building document intelligence, semantic search and LLM pipelines.
          </p>
        </article>
        <article class="panel reveal stack-y">
          <h3 class="panel-title">Expertise</h3>
          <p class="muted">
            AI agents, LLMs, RAG, evaluation, computer vision and cloud-native ML deployment, turning research into
            systems with measurable impact.
          </p>
        </article>
      </div>
      <div class="card-grid-3 numbers">
        {highlights.map((h) => (
          <div class="panel reveal number">
            <span class="big-number">{h.value}</span>
            <span class="number-label">{h.label}</span>
            <span class="meta">{h.context}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="section" id="education" aria-labelledby="edu-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">02 / Education</p>
          <h2 id="edu-title" class="h2">Education</h2>
        </div>
      </div>
      <div class="card-grid-2">
        {education.map((e) => (
          <article class="panel reveal stack-y">
            <h3 class="panel-title big">{e.school}</h3>
            <p class="degree">{e.degree}</p>
            <p class="meta">{e.dates.toUpperCase()} · {e.location.toUpperCase()}</p>
            <ul class="tags">{e.focus.map((f) => <li class="tag">{f}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">03 / Featured projects</p>
          <h2 id="projects-title" class="h2">Featured <span class="accent">projects.</span></h2>
        </div>
        <a href="/work" class="text-link"><span>All projects →</span></a>
      </div>
      <ProjectGrid projects={featured} />
    </div>
  </section>

  <!-- Experience -->
  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">04 / Work experience</p>
          <h2 id="exp-title" class="h2">Work <span class="accent">experience.</span></h2>
        </div>
        <a href="/experience" class="text-link"><span>All experience →</span></a>
      </div>
      <div class="stack-y roles">
        {roles.map((r) => (
          <article class="panel reveal role">
            <div class="role-head">
              <div>
                <p class="label subtle">{r.data.short}</p>
                <h3 class="panel-title big">{r.data.role}</h3>
              </div>
              <p class="meta role-meta">{r.data.start.toUpperCase()} — {r.data.end.toUpperCase()}{r.data.location && ` · ${r.data.location.toUpperCase()}`}</p>
            </div>
            <p class="label subtle">Key achievements</p>
            <ul class="bullets">{r.data.owned.map((o) => <li>{o}</li>)}</ul>
            <ul class="tags">{r.data.skills.map((s) => <li class="tag">{s}</li>)}</ul>
            <a href={`/experience/${r.id}`} class="text-link"><span>Details →</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">05 / Technical skills</p>
          <h2 id="skills-title" class="h2">Technical <span class="accent">skills.</span></h2>
        </div>
      </div>
      <SkillFinder />
    </div>
  </section>

  <!-- Research -->
  <section class="section" id="research" aria-labelledby="research-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">06 / Research</p>
          <h2 id="research-title" class="h2">Research <span class="accent">publications.</span></h2>
        </div>
        <a href="/research" class="text-link"><span>All research →</span></a>
      </div>
      <div class="card-grid-3">
        {research.map((r) => (
          <article class="panel reveal stack-y paper">
            <div class="card-top">
              <span class="label subtle">{r.data.kind}</span>
              <span class="badge">{r.data.status}</span>
            </div>
            <h3 class="panel-title"><a href={`/research/${r.id}`}>{r.data.title}</a></h3>
            <p class="muted small">{r.data.summary}</p>
            {r.data.highlights.length > 0 && <ul class="bullets">{r.data.highlights.map((h) => <li>{h}</li>)}</ul>}
            <div class="card-actions">
              <a href={`/research/${r.id}`} class="text-link"><span>Details →</span></a>
              {r.data.links.paper && <a href={r.data.links.paper} target="_blank" rel="noreferrer" class="text-link"><span>Read paper ↗</span></a>}
              {r.data.links.code && <a href={r.data.links.code} target="_blank" rel="noreferrer" class="text-link"><span>Code ↗</span></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section" id="certifications" aria-labelledby="cert-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">07 / Certifications</p>
          <h2 id="cert-title" class="h2">Certifications</h2>
        </div>
      </div>
      <div class="card-grid-2">
        {certifications.map((c) => (
          <article class="panel reveal stack-y">
            <h3 class="panel-title">{c.title}</h3>
            <p class="hl">{c.issuer}</p>
            <p class="muted small">{c.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">08 / Get in touch</p>
          <h2 id="contact-title" class="h2">Get in <span class="accent">touch.</span></h2>
        </div>
        <p class="lead">Always open to discussing new opportunities, collaborations, or just having a chat about AI and ML.</p>
      </div>
      <Contact />
    </div>
  </section>
</Base>

<style>
  /* Headline spans the full width (two lines on desktop); copy and photo sit side by side below it. */
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); column-gap: 72px; align-items: center;
    padding-block: clamp(56px, 7vw, 88px) clamp(56px, 6vw, 80px);
  }
  .eyebrow { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
  .hero-title { grid-column: 1 / -1; font-size: clamp(40px, 5.9vw, 84px); margin-bottom: 32px; }
  /* Keeps the break after "survive" on wider screens; phones wrap naturally. */
  @media (min-width: 640px) { .hero-title .keep { white-space: nowrap; } }
  .hero-copy { display: flex; flex-direction: column; gap: 28px; align-self: start; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .facts { margin: 0; padding-top: 22px; border-top: 1px solid var(--line-soft); }
  .hero-visual { width: 100%; max-width: 380px; justify-self: end; align-self: start; }
  .now { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; max-width: 560px; }
  .now .badge { margin-bottom: 4px; }
  .now-title { font-size: clamp(24px, 2.4vw, 30px); font-weight: 400; letter-spacing: -0.02em; transition: color 0.2s; }
  .now:hover .now-title { color: var(--cyan); }
  .now .text-link { min-height: 32px; }

  section[id] { scroll-margin-top: 80px; }
  .stack-y { display: flex; flex-direction: column; gap: 14px; }
  .stack-y > p { margin: 0; }
  .panel-title { margin: 0; font-size: 22px; font-weight: 400; letter-spacing: -0.015em; line-height: 1.25; }
  .panel-title.big { font-size: clamp(22px, 2.2vw, 28px); }
  .panel-title a:hover { color: var(--cyan); }
  .hl { color: var(--cyan); margin: 0; }
  .small { font-size: 15px; }
  .degree { color: var(--cyan); font-size: 17px; }
  .inline { color: var(--cyan); border-bottom: 1px solid #2d4853; }
  .inline:hover { border-color: var(--cyan); }

  .numbers { margin-top: 20px; }
  .number { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding-block: 32px; }
  .number-label { font-size: 17px; }

  .card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .card-actions { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 0 24px; border-top: 1px solid var(--line-soft); }

  .roles { gap: 20px; }
  .role { display: flex; flex-direction: column; gap: 16px; }
  .role-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 8px 24px; }
  .role-head .label { margin-bottom: 8px; }
  .role-meta { margin: 6px 0 0; }

  @media (max-width: 1080px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .eyebrow { margin-bottom: 24px; }
    .hero-title { margin-bottom: 32px; }
    .hero-visual { justify-self: center; max-width: 340px; margin-top: 56px; }
  }
</style>

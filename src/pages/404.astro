---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="wrap page-head" style="min-height: 60vh; justify-content: center;">
    <p class="label">404 / Signal lost</p>
    <h1 class="h1">This page drifted <span class="accent">out of orbit.</span></h1>
    <div class="link-row" style="gap: 12px;">
      <a href="/" class="btn btn-primary">Back home <span aria-hidden="true">→</span></a>
      <a href="/work" class="btn btn-secondary">See my work</a>
    </div>
  </div>
</Base>

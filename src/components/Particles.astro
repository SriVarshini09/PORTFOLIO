---
// Small glowing dots that drift upward behind the page, like fireflies in a night sky.
// Purely decorative; stays still for visitors who ask for reduced motion.
---

<canvas class="particles" aria-hidden="true" data-particles></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    // Aqua, pale aqua and a few white sparkles, sampled from the reference night scene.
    const colors = ['64, 224, 230', '125, 240, 235', '225, 248, 255'];
    const weights = [0.6, 0.25, 0.15];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // One soft glow sprite per color, drawn once and reused for every dot.
    const sprites = colors.map((rgb) => {
      const s = document.createElement('canvas');
      s.width = s.height = 32;
      const g = s.getContext('2d')!;
      const grad = g.createRadialGradient(16, 16, 0, 16, 16, 16);
      grad.addColorStop(0, 'rgba(235, 252, 255, 1)');
      grad.addColorStop(0.12, `rgba(${rgb}, 1)`);
      grad.addColorStop(0.35, `rgba(${rgb}, 0.45)`);
      grad.addColorStop(1, `rgba(${rgb}, 0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 32, 32);
      return s;
    });

    type Dot = { x: number; y: number; r: number; vy: number; sway: number; phase: number; alpha: number; tw: number; c: number };
    let dots: Dot[] = [];
    let w = 0;
    let h = 0;

    const pickColor = () => {
      const n = Math.random();
      return n < weights[0] ? 0 : n < weights[0] + weights[1] ? 1 : 2;
    };
    const spawn = (anywhere: boolean): Dot => ({
      x: Math.random() * w,
      y: anywhere ? Math.random() * h : h + 10,
      r: 0.7 + Math.random() * 1.8,
      vy: 0.12 + Math.random() * 0.35,
      sway: 0.2 + Math.random() * 0.5,
      phase: Math.random() * Math.PI * 2,
      alpha: 0.45 + Math.random() * 0.5,
      tw: 0.6 + Math.random() * 1.4,
      c: pickColor(),
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const widthChanged = window.innerWidth !== w;
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Phones resize the height while scrolling (address bar); only reseed when the width changes.
      if (widthChanged || dots.length === 0) {
        const count = Math.min(110, Math.round((w * h) / 16000));
        dots = Array.from({ length: count }, () => spawn(true));
      }
      if (still) draw(0);
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const d of dots) {
        const twinkle = 0.6 + 0.4 * Math.sin(t / 1000 * d.tw + d.phase);
        const size = d.r * 6;
        ctx.globalAlpha = d.alpha * twinkle;
        ctx.drawImage(sprites[d.c], d.x - size / 2, d.y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    };

    let last = performance.now();
    const tick = (t: number) => {
      const dt = Math.min(50, t - last) / 16.7;
      last = t;
      for (let i = 0; i < dots.length; i++) {
        const d = dots[i];
        d.y -= d.vy * dt;
        d.x += Math.sin(t / 1600 + d.phase) * d.sway * 0.25 * dt;
        if (d.y < -10) dots[i] = spawn(false);
      }
      draw(t);
      if (!document.hidden) requestAnimationFrame(tick);
    };

    resize();
    window.addEventListener('resize', resize);
    if (!still) {
      requestAnimationFrame(tick);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
          last = performance.now();
          requestAnimationFrame(tick);
        }
      });
    }
  }
</script>

<style>
  .particles { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
</style>

---
// Small glowing aqua butterflies that wander across the page behind the content.
// Hidden for visitors who ask for reduced motion.
const count = 2;
---

<div class="butterflies" aria-hidden="true">
  {
    Array.from({ length: count }, () => (
      <div class="bf" data-butterfly>
        <svg viewBox="-20 -18 40 36" width="26" height="24">
          <g class="wing left">
            <path d="M-1 -1 C-6 -15 -19 -15 -18 -5 C-17 2 -8 3 -1 1 Z" />
            <path d="M-1 1 C-8 3 -15 8 -12 13 C-9 17 -3 10 -1 3 Z" />
          </g>
          <g class="wing right">
            <path d="M1 -1 C6 -15 19 -15 18 -5 C17 2 8 3 1 1 Z" />
            <path d="M1 1 C8 3 15 8 12 13 C9 17 3 10 1 3 Z" />
          </g>
          <path class="body" d="M0 -6 L0 9" />
          <path class="antenna" d="M0 -6 C-1 -10 -3 -12 -4 -13 M0 -6 C1 -10 3 -12 4 -13" />
        </svg>
      </div>
    ))
  }
</div>

<script>
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = [...document.querySelectorAll<HTMLElement>('[data-butterfly]')];

  if (!still && els.length) {
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const flyers = els.map((el, i) => {
      // Fewer butterflies on small screens.
      if (i > 0 && window.innerWidth < 700) {
        el.style.display = 'none';
        return null;
      }
      el.style.setProperty('--flap-delay', `${-i * 0.11}s`);
      return { el, x: rand(0.1, 0.9) * innerWidth, y: rand(0.3, 0.9) * innerHeight, vx: 0, vy: 0, tx: 0, ty: 0, next: 0 };
    }).filter(Boolean) as { el: HTMLElement; x: number; y: number; vx: number; vy: number; tx: number; ty: number; next: number }[];

    let last = performance.now();
    const tick = (t: number) => {
      const dt = Math.min(50, t - last) / 16.7;
      last = t;
      for (const f of flyers) {
        // Pick a new spot to drift toward every few seconds.
        if (t > f.next) {
          f.tx = rand(0.05, 0.95) * innerWidth;
          f.ty = rand(0.15, 0.9) * innerHeight;
          f.next = t + rand(6000, 11000);
        }
        // Slow, lazy drift toward the target plus a little flutter: about 40 px/s on average.
        f.vx += ((f.tx - f.x) * 0.00004 + Math.sin(t / 700 + f.next) * 0.012) * dt;
        f.vy += ((f.ty - f.y) * 0.00004 + Math.cos(t / 850 + f.next) * 0.014) * dt;
        f.vx *= 0.975;
        f.vy *= 0.975;
        f.x += f.vx * dt;
        f.y += f.vy * dt;
        const tilt = Math.max(-20, Math.min(20, f.vx * 14));
        f.el.style.transform = `translate3d(${f.x}px, ${f.y}px, 0) rotate(${tilt}deg)`;
      }
      if (!document.hidden) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        last = performance.now();
        requestAnimationFrame(tick);
      }
    });
    document.documentElement.classList.add('butterflies-on');
  }
</script>

<style>
  .butterflies { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .bf { position: absolute; left: -13px; top: -12px; display: none; will-change: transform; }
  :global(.butterflies-on) .bf { display: block; }
  .bf svg { overflow: visible; filter: drop-shadow(0 0 3px rgba(64, 224, 230, 0.9)) drop-shadow(0 0 10px rgba(64, 224, 230, 0.45)); }
  .wing path { fill: rgba(64, 224, 230, 0.28); stroke: #6ff2ec; stroke-width: 1.1; stroke-linejoin: round; }
  .body { stroke: #c8fffb; stroke-width: 1.6; stroke-linecap: round; }
  .antenna { fill: none; stroke: #6ff2ec; stroke-width: 0.7; stroke-linecap: round; }
  .wing { transform-box: view-box; transform-origin: 0 0; animation: flap 0.55s ease-in-out infinite alternate; animation-delay: var(--flap-delay, 0s); }
  @keyframes flap { from { transform: scaleX(1); } to { transform: scaleX(0.25); } }
</style>
